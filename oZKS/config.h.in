#pragma once

#define OZKS_VERSION "@OZKS_VERSION@"
#define OZKS_VERSION_MAJOR @OZKS_VERSION_MAJOR@
#define OZKS_VERSION_MINOR @OZKS_VERSION_MINOR@
#define OZKS_VERSION_PATCH @OZKS_VERSION_PATCH@

#define @OZKS_SYSTEM@

// Intrinsics
#cmakedefine OZKS_USE_INTRIN
#cmakedefine OZKS_ARCH_ARM64
#cmakedefine OZKS_ARCH_AMD64
#cmakedefine OZKS_USE__BITSCANREVERSE64
#cmakedefine OZKS_USE___BUILTIN_CLZLL

// Enables extra storage-layer invariant checks (e.g. MemoryStorage's leaf save-once
// invariant). Defaulted ON in test builds (OZKS_BUILD_TESTS) and compiled out otherwise so
// production builds pay no runtime cost.
#cmakedefine OZKS_STORAGE_INVARIANT_CHECKS
