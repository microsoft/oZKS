namespace ozks.fbs;

table QueryResult {
    key:[ubyte] (required);
    payload:[ubyte] (required);
    vrf_proof:[ubyte];
    randomness:[ubyte] (required);
    use_vrf:bool;
    lookup_proof_count:uint32;
    version:uint32;
    epoch:uint64;
}

root_type QueryResult;
