include "core_types.fbs";
namespace ozks.fbs;

table OptionalPartialLabel {
    label:PartialLabel;
}

table CTNodeStored {
    label:PartialLabel;
    hash:Hash;
    epoch:uint64;
    left:OptionalPartialLabel;
    left_epoch:uint64;
    right:OptionalPartialLabel;
    right_epoch:uint64;
}

root_type CTNodeStored;
